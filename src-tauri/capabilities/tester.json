{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tester",
  "description": "Capability for the tester window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:event:default",
    "opener:default",
    "store:default",
    "log:default",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$DOWNLOAD/watchdog-action-recording-*.json" }]
    }
  ]
}
