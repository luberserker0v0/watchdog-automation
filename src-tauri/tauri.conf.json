{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "watch-dog",
  "version": "1.0.0",
  "identifier": "com.berserker.watch-dog",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:12420",
    "beforeBuildCommand": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-onnxruntime.ps1 -Profile release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "watch-dog",
        "width": 1200,
        "height": 700,
        "minWidth": 900,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "luberserker0v0",
    "homepage": "https://github.com/luberserker0v0/watchdog-automation",
    "copyright": "Copyright 2026 luberserker0v0",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*",
      "native/windows-x64"
    ]
  }
}
