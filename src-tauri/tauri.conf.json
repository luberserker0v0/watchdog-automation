{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "watch-dog",
  "version": "1.1.0",
  "identifier": "com.berserker.watch-dog",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:12420",
    "beforeBuildCommand": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-onnxruntime.ps1 -Profile release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "watch-dog",
        "width": 1200,
        "height": 700,
        "minWidth": 900,
        "minHeight": 500,
        "visible": false
      },
      {
        "label": "splash",
        "title": "Starting WatchDog",
        "url": "/splash.html",
        "width": 460,
        "height": 290,
        "center": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "splash",
        "preview"
      ]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/luberserker0v0/watchdog-automation/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDQUYyODk4RTA5ODg3RTIKUldUaWg1amdtQ2l2N0VwLzdna09kU25RaHI5aFFWVkVnT2x6cTViWXcyRTg4cEoraHN0TzBaRFEK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "luberserker0v0",
    "homepage": "https://github.com/luberserker0v0/watchdog-automation",
    "copyright": "Copyright 2026 luberserker0v0",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": "resources/",
      "native/windows-x64": "native/windows-x64",
      "companions/windows-x64/": ""
    }
  }
}
