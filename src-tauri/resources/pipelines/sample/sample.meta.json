      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 300,
      "enabled": true,
      "max_hit": 1
    },
    "SwipeCards": {
      "recognition": {
        "type": "ColorMatch",
        "lower": [
          90,
          100,
          200
        ],
        "upper": [
          120,
          140,
          255
        ]
      },
      "actions": [
        {
          "type": "Swipe",
          "begin": true,
          "end": [
            500,
            400
          ],
          "duration": 300
        }
