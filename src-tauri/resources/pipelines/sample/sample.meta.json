{
  "target": {
    "title": "^Target UI$",
    "type": "window",
    "capture_area": "client",
    "window_size": [
      500, 600
    ]
  },
  "launch": {
    "exe": "watch-dog-target.exe",
    "wait_for_window": true,
    "wait_timeout_ms": 10000
  },
  "nodes": {
    "Start": {
      "kind": "Entry",
      "timeout": 20000
    },
    "RecognizeTitle": {
      "recognition": {
        "type": "OCR",
        "expected": "Welcome Back",
        "threshold": 0.6,
        "roi": [
          175, 178, 159, 40
        ]
      },
      "actions": [
        {
          "type": "DoNothing"
        }
      ],
      "timeout": 20000,
      "rate_limit": 1000,
      "pre_delay": 200,
      "post_delay": 200,
      "max_hit": 1
    },
    "InputAccount": {
      "recognition": {
        "type": "OCR",
        "expected": "Account",
        "roi": [
          75, 255, 58, 24
        ]
      },
      "actions": [
        {
          "type": "Click",
          "target_offset": [
            35,
            35,
            0,
            0
          ]
        },
        {
          "type": "InputText",
          "input_text": "{{account}}"
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 100,
      "max_hit": 1
    },
    "InputPassword": {
      "recognition": {
        "type": "OCR",
        "expected": "Password",
        "roi": [
          74, 336, 70, 23
        ]
      },
      "actions": [
        {
          "type": "Click",
          "target_offset": [
            35,
            35,
            0,
            0
          ]
        },
        {
          "type": "InputText",
          "input_text": "{{password}}"
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 100,
      "max_hit": 1
    },
    "ClickLogin": {
      "recognition": {
        "type": "OCR",
        "roi": [
         221, 427, 59, 100
        ]
      },
      "actions": [
        {
          "type": "Click"
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 500,
      "max_hit": 1
    },
    "LoginError": {
      "recognition": {
        "type": "OCR",
        "expected": "Invalid",
        "roi": [
          178, 398, 150, 21
        ],
        "threshold": 0.6
      },
      "actions": [
        {
          "type": "ClickKey",
          "key": [
            27
          ]
        }
      ],
      "timeout": 5000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 200,
      "max_hit": 1
    },
    "VerifySuccess": {
      "recognition": {
        "type": "OCR",
        "expected": "Dashboard",
        "roi": [
          182, 95, 128, 36
        ],
        "threshold": 0.6
      },
      "actions": [
        {
          "type": "DoNothing"
        }
      ],
      "timeout": 10000,
      "rate_limit": 1000,
      "pre_delay": 200,
      "post_delay": 200,
      "max_hit": 1
    },
    "ClickNotification": {
      "recognition": {
        "type": "TemplateMatch",
        "template": "sample/notification.png",
        "threshold": 0.8
      },
      "actions": [
        {
          "type": "Click"
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 300,
      "max_hit": 1
    },
    "SwipeCards": {
      "recognition": {
        "type": "ColorMatch",
        "lower": [
          90,
          100,
          200
        ],
        "upper": [
          120,
          140,
          255
        ]
      },
      "actions": [
        {
          "type": "Swipe",
          "begin": true,
          "end_offset": [
            -100,
            0,
            0,
            0
          ],
          "duration": 300
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 300,
      "max_hit": 1
    },
    "ScrollList": {
      "recognition": {
        "type": "OCR",
        "expected": "NOTIFICATIONS",
        "roi": [
          10, 307, 113, 18
        ],
        "threshold": 0.6
      },
      "actions": [
        {
          "type": "Scroll",
          "target_offset": [
            0,
            100,
            0,
            0
          ],
          "dx": 0,
          "dy": 100
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 300,
      "max_hit": 1
    },
    "ScrollPage": {
      "actions": [
        {
          "type": "Scroll",
          "target": [
            100,
            100,
            0,
            0
          ],
          "dx": 0,
          "dy": 1
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 300,
      "max_hit": 1
    },
    "PressDelete": {
      "recognition": {
        "type": "TemplateMatch",
        "template": "sample/delete.png",
        "threshold": 0.7
      },
      "actions": [
        {
          "type": "LongPress",
          "duration": 1500
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 300,
      "max_hit": 1
    },
    "ClickRefresh": {
      "recognition": {
        "type": "TemplateMatch",
        "template": "sample/refresh.png",
        "threshold": 0.7
      },
      "actions": [
        {
          "type": "Click"
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 200,
      "max_hit": 1
    },
    "ClickKeyboard": {
      "actions": [
        { "type": "ClickKey", "key": ["{{key}}"] }
      ]
    },
    "FindKeyDetectPanel": {
      "recognition": {
        "type": "OCR",
        "expected": "KEY DETECT AREA"
      }
    },
    "VerifyKeyboard": {
      "recognition": {
        "type": "OCR",
        "roi": "FindKeyDetectPanel",
        "roi_offset": [
          200, 30, 130, 50
        ],
        "expected": "{{key}}"
      }
    },
    "Done": {
      "kind": "Endpoint",
      "max_hit": 1
    }
  },
  "instances": {
    "Start": {
      "node": "Start"
    },
    "RecognizeTitle": {
      "node": "RecognizeTitle"
    },
    "InputAccount": {
      "node": "InputAccount",
      "params": [
        {
          "type": "text",
          "key": "account",
          "label": "Account",
          "default": "admin"
        }
      ],
      "param_values": {
        "account": "admin"
      }
    },
    "InputPassword": {
      "node": "InputPassword",
      "params": [
        {
          "type": "password",
          "key": "password",
          "label": "Password",
          "default": "123456"
        }
      ]
    },
    "ClickLogin": {
      "node": "ClickLogin"
    },
    "LoginError": {
      "node": "LoginError"
    },
    "VerifySuccess": {
      "node": "VerifySuccess"
    },
    "ClickNotification": {
      "node": "ClickNotification"
    },
    "SwipeCards": {
      "node": "SwipeCards"
    },
    "ScrollList": {
      "node": "ScrollList"
    },
    "ScrollPage": {
      "node": "ScrollPage"
    },
    "PressDelete": {
      "node": "PressDelete"
    },
    "ClickRefresh": {
      "node": "ClickRefresh"
    },
    "ScrollPage2": {
      "node": "ScrollPage"
    },
    "ClickKeyboard": {
      "node": "ClickKeyboard",
      "params": [
        {
          "type": "number",
          "key": "key",
          "label": "Key",
          "default": 19
        }
      ]
    },
    "FindKeyDetectPanel": {
      "node": "FindKeyDetectPanel"
    },
    "VerifyKeyboard": {
      "node": "VerifyKeyboard",
      "params": [
        {
          "type": "text",
          "key": "key",
          "label": "Key",
          "default": "pause"
        }
      ]
    },
    "Done": {
      "node": "Done"
    }
  }
}
