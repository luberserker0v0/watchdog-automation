    "PressDelete": {
      "recognition": {
        "type": "DirectHit"
      },
      "actions": [
        {
          "type": "LongPress",
          "target": true,
          "duration": 1500
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 300,
      "enabled": true,
      "max_hit": 1
