{
  "nodes": {
    "RecognizeTitle": {
      "recognition": {
        "type": "OCR",
        "expected": "Login",
        "threshold": 0.6
      },
      "actions": [
        {
          "type": "DoNothing"
        }
      ],
      "timeout": 20000,
      "rate_limit": 1000,
      "pre_delay": 200,
      "post_delay": 200,
      "enabled": true,
      "inverse": false,
      "max_hit": 1
    },
    "InputAccount": {
      "recognition": {
        "type": "DirectHit"
      },
      "actions": [
        {
          "type": "InputText",
          "input_text": "{{account}}"
        }
      ],
      "params": [
        {
          "type": "text",
          "key": "account",
          "label": "Account",
          "default": "admin"
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 100,
      "enabled": true,
      "max_hit": 1
    },
    "InputPassword": {
      "recognition": {
        "type": "DirectHit"
      },
      "actions": [
        {
          "type": "InputText",
          "input_text": "{{password}}"
        }
      ],
      "params": [
        {
          "type": "password",
          "key": "password",
          "label": "Password",
          "default": "123456"
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 100,
      "enabled": true,
      "max_hit": 1
    },
    "ClickLogin": {
      "recognition": {
        "type": "DirectHit"
      },
      "actions": [
        {
          "type": "Click",
          "target": true
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 500,
      "enabled": true,
      "max_hit": 1
    },
    "LoginError": {
      "recognition": {
        "type": "OCR",
        "expected": "Invalid",
        "threshold": 0.6
      },
      "actions": [
        {
          "type": "ClickKey",
          "key": [
            27
          ]
        }
      ],
      "timeout": 5000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 200,
      "enabled": true,
      "max_hit": 1
    },
    "VerifySuccess": {
      "recognition": {
        "type": "OCR",
        "expected": "Dashboard",
        "threshold": 0.6
      },
      "actions": [
        {
          "type": "DoNothing"
        }
      ],
      "timeout": 10000,
      "rate_limit": 1000,
      "pre_delay": 200,
      "post_delay": 200,
      "enabled": true,
      "inverse": false,
      "max_hit": 1
