    "LoginError->VerifySuccess": { "edge_type": "next" },
    "VerifySuccess->ClickNotification": { "edge_type": "next" },
    "ClickNotification->SwipeCards": { "edge_type": "next" },
    "SwipeCards->ScrollList": { "edge_type": "next" },
    "ScrollList->PressDelete": { "edge_type": "next" },
    "PressDelete->ClickRefresh": { "edge_type": "next" },
