    "ClickRefresh": {
      "recognition": {
        "type": "DirectHit"
      },
      "actions": [
        {
          "type": "Click",
          "target": [
            300,
            400
          ]
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 200,
      "enabled": true,
