{
  "nodes": {
    "InputAccount": {
      "target": {
        "type": "window",
        "title": "^Target UI - Login$",
        "capture_area": "client"
      },
      "recognition": {
        "type": "OCR",
        "expected": "^Account$",
        "threshold": 0.6,
        "candidate_selection": {
          "order": "left_to_right",
          "index": 0
        }
      },
      "actions": [
        {
          "type": "Click",
          "target": true,
          "target_offset": [
            30,
            38,
            0,
            0
          ]
        },
        {
          "type": "InputText",
          "input_text": "{{account}}"
        }
      ],
      "params": [
        {
          "type": "text",
          "key": "account",
          "label": "Account",
          "default": "admin"
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 100,
      "enabled": true,
      "max_hit": 1
    }
  }
}
