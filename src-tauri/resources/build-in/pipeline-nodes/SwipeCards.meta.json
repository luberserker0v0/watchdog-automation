{
  "nodes": {
    "SwipeCards": {
      "target": {
        "type": "window",
        "title": "^Target UI - Dashboard$",
        "capture_area": "client"
      },
      "recognition": {
        "type": "OCR",
        "expected": "Card",
        "roi": [
          0,
          130,
          480,
          32
        ],
        "threshold": 0.6,
        "candidate_selection": {
          "order": "left_to_right",
          "index": 0
        }
      },
      "actions": [
        {
          "type": "Swipe",
          "begin": true,
          "begin_offset": [
            80,
            25,
            0,
            0
          ],
          "end": true,
          "end_offset": [
            -80,
            25,
            0,
            0
          ],
          "duration": 300
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 300,
      "enabled": true,
      "max_hit": 1
    }
  }
}
