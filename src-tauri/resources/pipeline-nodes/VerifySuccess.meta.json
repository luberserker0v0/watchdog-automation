{
  "nodes": {
    "VerifySuccess": {
      "target": {
        "type": "window",
        "title": "^Target UI - Dashboard$",
        "capture_area": "frame"
      },
      "recognition": {
        "type": "OCR",
        "expected": "Dashboard",
        "threshold": 0.6,
        "candidate_selection": {
          "order": "confidence_desc",
          "index": 0
        }
      },
      "actions": [
        {
          "type": "DoNothing"
        }
      ],
      "timeout": 10000,
      "rate_limit": 1000,
      "pre_delay": 200,
      "post_delay": 200,
      "enabled": true,
      "max_hit": 1
    }
  }
}
