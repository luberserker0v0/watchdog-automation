{
  "nodes": {
    "RecognizeTitle": {
      "target": {
        "type": "window",
        "title": "^Target UI - Login$",
        "capture_area": "client"
      },
      "recognition": {
        "type": "OCR",
        "expected": "^Welcome Back$",
        "threshold": 0.6,
        "candidate_selection": {
          "order": "top_to_bottom",
          "index": 0
        }
      },
      "actions": [
        {
          "type": "DoNothing"
        }
      ],
      "timeout": 20000,
      "rate_limit": 1000,
      "pre_delay": 200,
      "post_delay": 200,
      "enabled": true,
      "max_hit": 1
    }
  }
}
