{
  "nodes": {
    "PressKeyboardKey": {
      "target": {
        "type": "window",
        "title": "^Target UI - Dashboard$",
        "capture_area": "client"
      },
      "recognition": {
        "type": "OCR",
        "expected": "^Key Detect Area$",
        "threshold": 0.6,
        "candidate_selection": {
          "order": "native",
          "index": 0
        }
      },
      "actions": [
        {
          "type": "ClickKey",
          "key": [
            27
          ]
        }
      ],
      "timeout": 10000,
      "rate_limit": 500,
      "pre_delay": 100,
      "post_delay": 200,
      "enabled": true,
      "max_hit": 1
    }
  }
}
